{
  "name": "forge-audio-desktop",
  "productName": "Forge Audio",
  "version": "0.3.1",
  "description": "Forge Audio — lecteur musical libre et sans pub",
  "author": "Heiphaistos",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "main.js",
  "scripts": {
    "prepare-app": "node scripts/prepare.mjs",
    "dev": "npm run prepare-app && electron .",
    "dist": "npm run prepare-app && electron-builder --publish never",
    "dist:win": "npm run prepare-app && electron-builder --win --publish never",
    "dist:mac": "npm run prepare-app && electron-builder --mac --publish never",
    "dist:linux": "npm run prepare-app && electron-builder --linux --publish never"
  },
  "dependencies": {
    "@fastify/static": "^8.2.0",
    "fastify": "^5.6.0",
    "ffmpeg-static": "^5.2.0"
  },
  "devDependencies": {
    "electron": "^38.1.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "org.heiphaistos.forgeaudio",
    "productName": "Forge Audio",
    "copyright": "Heiphaistos — MIT",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.cjs",
      "ytdlp-manager.js",
      "app/**/*",
      "build/icon.png",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "ForgeAudio-${version}-win-${arch}.${ext}"
    },
    "nsis": {
      "artifactName": "ForgeAudio-${version}-win-${arch}-nsis.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Forge Audio"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.music",
      "artifactName": "ForgeAudio-${version}-mac-${arch}.${ext}"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "tar.gz",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "AudioVideo",
      "maintainer": "Heiphaistos",
      "artifactName": "ForgeAudio-${version}-linux-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "ForgeAudio-${version}-win-portable.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Heiphaistos",
        "repo": "Forge-audio-",
        "releaseType": "release"
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Heiphaistos/Forge-audio-.git"
  }
}
